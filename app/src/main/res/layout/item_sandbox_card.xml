<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card_minimal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_sandbox_card_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_accent_soft"
        android:fontFamily="@font/inter"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/sl_accent_strong"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_sandbox_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textColor="@color/sl_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_sandbox_card_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/sl_text_secondary"
        android:textSize="14sp" />

</LinearLayout>
