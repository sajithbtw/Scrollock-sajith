<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sl_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="@string/focus_title"
            android:textColor="@color/sl_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Guard Banner -->
        <LinearLayout
            android:id="@+id/card_guard_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_subtle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/iv_guard_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield_check" />

            <TextView
                android:id="@+id/tv_guard_status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:text="@string/focus_guard_active"
                android:textColor="@color/sl_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Duration Presets -->
        <TextView
            android:id="@+id/tv_duration_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/inter"
            android:text="@string/focus_duration_label"
            android:textColor="@color/sl_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_15_min"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/focus_duration_15" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_25_min"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/focus_duration_25" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_45_min"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/focus_duration_45" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_60_min"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/focus_duration_60" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_90_min"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/focus_duration_90" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_custom_min"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/focus_duration_custom" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Main Countdown Ring Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_minimal"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <FrameLayout
                android:layout_width="228dp"
                android:layout_height="228dp">

                <com.sajith.scrolllock.ui.common.FocusRingView
                    android:id="@+id/focus_ring_session"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_session_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono"
                        android:text="25:00"
                        android:textColor="@color/sl_text_primary"
                        android:textSize="44sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_session_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter"
                        android:text="@string/status_ready"
                        android:textColor="@color/sl_accent_strong"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_focus_start_pause"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1.5"
                    android:backgroundTint="@color/sl_accent"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/btn_start_focus"
                    android:textAllCaps="false"
                    android:textColor="@color/sl_on_accent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    app:iconTint="@color/sl_on_accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_focus_reset"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter"
                    android:text="@string/btn_reset"
                    android:textAllCaps="false"
                    android:textColor="@color/sl_text_primary"
                    android:textSize="15sp"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_reset"
                    app:iconGravity="textStart"
                    app:iconTint="@color/sl_text_primary"
                    app:strokeColor="@color/sl_border" />
            </LinearLayout>
        </LinearLayout>

        <!-- Session Completion Banner (Shown when COMPLETED) -->
        <LinearLayout
            android:id="@+id/card_session_complete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_minimal"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/focus_completion_title"
                    android:textColor="@color/sl_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_completion_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter"
                android:textColor="@color/sl_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_start_another"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/sl_accent"
                    android:text="@string/btn_start_another"
                    android:textAllCaps="false"
                    android:textColor="@color/sl_on_accent"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_complete_view_insights"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/btn_view_insights"
                    android:textAllCaps="false"
                    android:textColor="@color/sl_text_primary"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/sl_border" />
            </LinearLayout>
        </LinearLayout>

        <!-- Guarded Apps Preview Card -->
        <LinearLayout
            android:id="@+id/card_session_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_minimal"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="@string/label_selected_apps"
                    android:textColor="@color/sl_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_session_manage_apps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:minHeight="48dp"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:text="@string/label_manage_apps"
                    android:textColor="@color/sl_accent_strong"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_session_apps_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter"
                android:lineSpacingExtra="4dp"
                android:text="@string/focus_no_apps_warning"
                android:textColor="@color/sl_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Deep Focus Mode Card (DND Preview Hiding + Play-Safe Net Shield) -->
        <LinearLayout
            android:id="@+id/card_deep_focus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_minimal"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="@string/deep_focus_title"
                        android:textColor="@color/sl_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter"
                        android:text="@string/deep_focus_subtitle"
                        android:textColor="@color/sl_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_deep_focus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/deep_focus_title"
                    android:minHeight="48dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_deep_focus_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <!-- Option 1: Hide Notification Previews + DND Access Pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_subtle"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_deep_hide_previews"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter"
                        android:minHeight="48dp"
                        android:text="@string/deep_focus_hide_previews"
                        android:textColor="@color/sl_text_primary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_dnd_permission_pill"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/sl_accent_soft"
                        android:fontFamily="@font/inter"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/deep_focus_dnd_grant"
                        android:textAllCaps="false"
                        android:textColor="@color/sl_accent_strong"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- Option 2: Non-Essential Offline & Connectivity Shield -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card_subtle"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_deep_block_internet"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter"
                        android:minHeight="48dp"
                        android:text="@string/deep_focus_block_internet"
                        android:textColor="@color/sl_text_primary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_internet_panel_pill"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/inter"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/deep_focus_panel_btn"
                        android:textAllCaps="false"
                        android:textColor="@color/sl_accent_strong"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/sl_accent_strong" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_deep_focus_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/deep_focus_summary_format"
                    android:textColor="@color/sl_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_deep_focus_exceptions"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1.5"
                        android:fontFamily="@font/inter"
                        android:text="@string/deep_focus_exceptions_btn"
                        android:textAllCaps="false"
                        android:textColor="@color/sl_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/sl_border" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_deep_focus_data_saver"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/sl_accent_soft"
                        android:fontFamily="@font/inter"
                        android:text="@string/deep_focus_data_saver_btn"
                        android:textAllCaps="false"
                        android:textColor="@color/sl_accent_strong"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
