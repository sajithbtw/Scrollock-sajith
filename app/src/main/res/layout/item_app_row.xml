<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_minimal"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/iv_app_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:textColor="@color/sl_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_app_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:text="@string/apps_usage_unavailable"
            android:textColor="@color/sl_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_app_unlock_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_pill_accent_soft"
            android:fontFamily="@font/inter"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/sl_accent_strong"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_toggle_short_form"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@string/cd_toggle_short_form"
        android:fontFamily="@font/inter"
        android:insetTop="4dp"
        android:insetBottom="4dp"
        android:maxLines="1"
        android:minWidth="0dp"
        android:minHeight="48dp"
        android:paddingHorizontal="10dp"
        android:text="@string/btn_short_form_off"
        android:textAllCaps="false"
        android:textColor="@color/sl_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:strokeColor="@color/sl_border"
        app:strokeWidth="1dp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_app_selected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/cd_toggle_full_app_lock"
        android:minHeight="48dp" />

</LinearLayout>
