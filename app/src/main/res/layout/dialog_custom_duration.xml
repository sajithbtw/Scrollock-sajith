<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans"
        android:text="@string/custom_duration_dialog_title"
        android:textColor="@color/sl_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter"
        android:text="@string/custom_duration_dialog_subtitle"
        android:textColor="@color/sl_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_custom_minus_5"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="64dp"
            android:text="-5m"
            android:textAllCaps="false"
            android:textColor="@color/sl_text_primary"
            app:cornerRadius="12dp"
            app:strokeColor="@color/sl_border" />

        <TextView
            android:id="@+id/tv_custom_minutes_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/jetbrains_mono"
            android:gravity="center"
            android:text="90 min"
            android:textColor="@color/sl_accent_strong"
            android:textSize="28sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_custom_plus_5"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="64dp"
            android:text="+5m"
            android:textAllCaps="false"
            android:textColor="@color/sl_text_primary"
            app:cornerRadius="12dp"
            app:strokeColor="@color/sl_border" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_custom_minutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:stepSize="5.0"
        android:value="90.0"
        android:valueFrom="5.0"
        android:valueTo="180.0"
        app:thumbColor="@color/sl_accent"
        app:trackColorActive="@color/sl_accent"
        app:trackColorInactive="@color/sl_border" />

</LinearLayout>
