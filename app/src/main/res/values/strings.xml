    <string name="settings_limitations_title">Play Protect &amp; Android Safety Design</string>
    <string name="settings_limitations_body">ScrollLock is built to obey Google Play Protect and Digital Wellbeing rules: it uses user-granted Usage Access, official Notification Policy (DND) preview suppression, Android\'s native Internet Connectivity Panel, and explicit heads-up Focus Guard alerts—with zero Accessibility window snooping and zero unauthorized background VPN interception.</string>
    <string name="settings_privacy_title">Privacy &amp; Local Storage</string>
    <string name="settings_privacy_body">All app selections, focus timers, and usage summaries stay strictly on your device in local SQLite &amp; SharedPreferences storage. ScrollLock has no accounts, no analytics, and zero network transmission.</string>
    <string name="settings_version_format">ScrollLock v%s • Package: com.sajith.scrolllock</string>

