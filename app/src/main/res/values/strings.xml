    <string name="perm_dnd_title">Deep Focus Preview Hiding (DND Policy)</string>
    <string name="perm_dnd_desc">Uses Android\'s official Do Not Disturb Policy to hide notification previews, peeking popups, and lock-screen banners during Deep Focus—preserving alarms and repeat callers.</string>
    <string name="perm_dnd_steps">Setup: Open Do Not Disturb Access -> Select ScrollLock -> Allow.</string>
    <string name="perm_usage_title">Usage Access (App &amp; Guard Monitor)</string>
    <string name="perm_usage_desc">Reads foreground usage events and screen time strictly on-device to show real statistics and trigger Focus Guard notifications.</string>
    <string name="perm_usage_steps">Setup: Open Usage Access Settings -> Select ScrollLock -> Allow usage tracking.</string>
    <string name="perm_notifications_title">Focus Guard Notifications</string>
    <string name="perm_notifications_desc">Displays live timer countdowns, completion alerts, and heads-up Workout-to-Unlock nudges while a Focus Session runs.</string>
